# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# OpenAI (server-side only, never exposed to the browser)
OPENAI_API_KEY=sk-...
# Optional: override the model used for all AI features
OPENAI_MODEL=gpt-4.1-mini

# Public URL of the deployed app (used for auth email redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase service role key (server-side only). Used for billing writes and Razorpay webhooks.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Razorpay (Dashboard -> Account & Settings -> API Keys). Use rzp_test_ keys until you go live.
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
# Dashboard -> Webhooks: URL https://YOUR-SITE/api/razorpay/webhook, secret below
RAZORPAY_WEBHOOK_SECRET=...
# Monthly plan ids (create with: node scripts/razorpay-create-plans.mjs)
RAZORPAY_PLAN_STARTER=plan_...
RAZORPAY_PLAN_PRO=plan_...
RAZORPAY_PLAN_TEAM=plan_...
